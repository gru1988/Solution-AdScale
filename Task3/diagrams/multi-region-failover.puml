@startuml
title Мультирегиональное развёртывание и failover (TO-BE)

skinparam componentStyle rectangle

cloud "DSP-партнёры" as dsp
node "GeoDNS / Anycast\n(health checks, TTL 30 с)" as dns

package "Регион A (primary для управления и финансов)" {
  [Edge RTB Gateway A] as gwA
  [Bidding A\n(active, 27 подов)] as bidA
  database "Redis A\n(Budget, Profile)" as redisA
  queue "Kafka A" as kA
  database "Campaign DB\nPRIMARY" as campA
  database "Finance DB\nPRIMARY fin_a1 + fin_a2" as finA
  database "ClickHouse\n(центральный DWH)" as chA
  [Campaign / Finance /\nStatistics / Analytics] as svcA
}

package "Регион B (active RTB, standby для управления)" {
  [Edge RTB Gateway B] as gwB
  [Bidding B\n(active, 27 подов)] as bidB
  database "Redis B\n(Budget, Profile)" as redisB
  queue "Kafka B" as kB
  database "Campaign DB\nasync replica" as campB
  database "Finance DB\nfin_b1, fin_b2\n(синхронный кворум)" as finB
  [Campaign / Finance\n(standby, scaled to 0–1)] as svcB
}

package "Регион C (свидетель)" {
  node "etcd witness\n(DCS Patroni)" as witness
}

dsp --> dns
dns --> gwA
dns --> gwB
gwA --> bidA
gwB --> bidB
bidA --> redisA
bidB --> redisB
bidA --> kA
bidB --> kB
svcA --> campA
svcA --> finA
svcA --> chA

kB ..> kA : MirrorMaker 2\n(события → центр)
kA ..> kB : MirrorMaker 2\n(campaign.changes)
campA ..> campB : WAL streaming (async)
finA --> finB : WAL sync\nANY 2 (fin_a2, fin_b1, fin_b2)

finA ..> witness : DCS (etcd кворум A+B+C)
finB ..> witness : DCS

note bottom of redisB
  Бюджеты делятся между регионами квотами (lease),
  межрегиональная синхронизация не нужна на пути запроса.
end note

note right of dns
  Отказ региона: DNS убирает регион ≤ 30 с,
  в каждом регионе постоянно 27 подов Bidding
  — это 50 000 RPS + 20% без автоскейлинга.
  RTB RTO ≤ 5 мин.
  Finance: промоут fin_b1/fin_b2 (наибольший LSN),
  проверка леджера, RPO = 0, RTO ≤ 15 мин.
  Campaign: промоут async-реплики, RTO ≤ 30 мин.
end note
@enduml
