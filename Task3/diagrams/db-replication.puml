@startuml
title Репликация и шардирование хранилищ (один регион, 3 AZ)

skinparam componentStyle rectangle
skinparam defaultTextAlignment center

package "Finance DB (PostgreSQL + Patroni quorum mode)" {
  database "fin_a1 Primary\nрегион A, AZ-a" as fp
  database "fin_a2\nрегион A, AZ-b" as fs1
  database "fin_b1\nрегион B, AZ-a" as fb1
  database "fin_b2\nрегион B, AZ-b" as fb2
  database "fin_a3 async\nрегион A, AZ-c (отчёты)" as fs2
  fp --> fs1 : кворум
  fp --> fb1 : кворум
  fp --> fb2 : кворум
  fp ..> fs2 : async
  note bottom of fb1
    synchronous_standby_names =
    'ANY 2 (fin_a2, fin_b1, fin_b2)'
    → каждая подтверждённая проводка
    есть минимум в одной реплике региона B
  end note
}

package "Campaign DB (PostgreSQL + Patroni)" {
  database "Primary\nAZ-a" as cp
  database "Sync standby\nAZ-b" as cs
  database "Read replica\nAZ-c (снапшоты, кабинет)" as cr
  database "Async replica\nрегион B" as cdr
  cp --> cs : sync
  cp ..> cr : async
  cp ..> cdr : async
}

package "Redis Cluster (hot path)" {
  node "Shard 1\nmaster AZ-a / replica AZ-b" as r1
  node "Shard 2\nmaster AZ-b / replica AZ-c" as r2
  node "Shard 3\nmaster AZ-c / replica AZ-a" as r3
  note bottom of r2
    16 384 hash slots
    budget:{campaign_id}, lease:{campaign_id}:pod
    seg:{user_id}, fcap:{user_id}
  end note
}

package "ClickHouse (Distributed, sharding_key = cityHash64(campaign_id))" {
  node "Shard 1\nreplica A (запись) / replica B (аналитика)" as ch1
  node "Shard 2\nreplica A / replica B" as ch2
  node "Shard 3\nreplica A / replica B" as ch3
  node "ClickHouse Keeper x3" as keeper
  ch1 -[hidden]- ch2
  ch2 -[hidden]- ch3
  keeper ..> ch1
  keeper ..> ch2
  keeper ..> ch3
  note bottom of ch2
    PARTITION BY toYYYYMMDD(ts)
    ORDER BY (campaign_id, event_type, ts)
    TTL сырые 90 дней, агрегаты 2 года
  end note
}

package "Kafka (KRaft, RF=3, min.insync=2)" {
  queue "Broker 1 AZ-a" as k1
  queue "Broker 2 AZ-b" as k2
  queue "Broker 3 AZ-c" as k3
  note bottom of k2
    ключ партиционирования: campaign_id
  end note
}
@enduml
